# Never place real credentials in this file.
JIRA_MCP_AUTH_HEADER=replace-through-secret-delivery
JIRA_CLOUD_ID=replace-with-authorized-cloud-id
JIRA_ALLOWED_PROJECT_KEYS=["WRD"]
# The Jira write path is fail-closed and may be enabled only for synthetic dev data.
JIRA_MUTATION_ENABLED=false
JIRA_WORKFORCE_EMPLOYEE_FIELD_ID=customfield_replace_after_validation
API_KEY_HMAC_PEPPER=replace-through-secret-delivery
AWS_REGION=us-east-1
